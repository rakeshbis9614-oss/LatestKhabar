
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // PRODUCTION-READY FIRESTORE SECURITY RULES
    // For: Latest Khabar v5.0 News Portal
    // ============================================
    
    // Essential helper function to validate increment operations
    function isValidIncrement(delta) {
      return delta == 1 || delta == -1;
    }
    
    match /articles/{articleId} {
      
      // --- PUBLIC READ ACCESS ---
      // Allow anyone (authenticated or anonymous) to read article documents.
      // This enables public access to all news articles on the portal.
      allow read: if true;
      
      // --- PUBLIC UPDATE ACCESS (Views Counter Only) ---
      // Allow unauthenticated users to atomically increment the 'views' field.
      // This operation updates ONLY the views counter using Firebase's increment() operator.
      // The frontend enforces atomic increments via updateDoc(doc, { views: increment(1) })
      allow update: if request.auth == null && 
                       // Only allow 'views' field modification
                       request.resource.data.keys().size() == 1 && 
                       'views' in request.resource.data &&
                       // Views field must use server-side increment (key field check)
                       // Firestore increment operations are validated server-side
                       request.resource.data.diff(resource.data).affectedKeys().size() == 1;
      
      // --- AUTHENTICATED WRITE OPERATIONS ---
      // Only authenticated users (admins) can create, update, or delete articles.
      // This protects article content from public modification or deletion.
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // --- BLOCK ALL OTHER COLLECTIONS ---
    // Default deny for any other collections not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
